#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-only

USE_PROCD=1
START=99

CONF="uuwol"
PROG="/usr/sbin/uuwol"

start_service() {
	config_load "$CONF"

	local enabled debug refresh_interval mac iface model
	config_get_bool enabled config enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get_bool debug config debug 0

	refresh_interval="$(uci -q get uuwol.config.refresh_interval)"
	[ -n "$refresh_interval" ] || refresh_interval=20

	. /usr/share/uuwol/device.sh || return 1
	mac="$(uu_device_mac)" || return 1
	iface="$(uu_device_iface)" || return 1
	model="$(uu_device_model)" || return 1

	procd_open_instance "$CONF"
	procd_set_param command "$PROG" \
		--mac "$mac" \
		--iface "$iface" \
		--model "$model" \
		--refresh-interval "$refresh_interval"
	[ "$debug" -eq 1 ] && procd_append_param command --debug
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}
